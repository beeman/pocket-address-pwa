{
  "name": "pocket-address-pwa",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci": "npm run lint:check && npm run format:check && npm run test && npm run build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview",
    "test": "bun test"
  },
  "displayName": "Pocket Address",
  "description": "Your Solana address, ready to share: a PWA that shows the connected wallet address as a QR code.",
  "usecase": "Mobile",
  "keywords": [
    "pwa",
    "qr-code",
    "react",
    "seeker-connect",
    "solana",
    "vite",
    "webshell"
  ],
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@solana-mobile/seeker-connect-ui": "^0.1.0",
    "@solana-mobile/seeker-connect-wallet-standard": "^0.1.0",
    "@solana-mobile/wallet-standard-mobile": "0.0.0-canary-20260828231154",
    "@solana/kit": "^8.0.0",
    "@solana/kit-plugin-wallet": "^0.18.0",
    "@solana/react": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "private": true
